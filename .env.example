DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5432/rag_db

TEST_DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5432/rag_test_db

# RustFS / S3-compatible storage
RUSTFS_ENDPOINT_URL=http://localhost:9000
RUSTFS_ACCESS_KEY=your_access_key
RUSTFS_SECRET_KEY=your_secret_key
RUSTFS_BUCKET=rag-raw-documents
RUSTFS_REGION=us-east-1

# Upload restrictions
MAX_UPLOAD_SIZE_MB=50
PRESIGNED_URL_EXPIRY=900